    "perceptual_hash": {
      "candidate_rule": "A pair is flagged when the minimum Hamming distance across all orientation-hash combinations satisfies pHash <= 10 OR dHash <= 8 (boundary equality included). These thresholds generate CANDIDATES only -- they never automatically declare duplication, and a negative scan does not prove that every crop or derivative is absent.",
      "dhash": {
        "bits": 64,
        "resample": "Pillow LANCZOS",
        "resize": [
          9,
          8
        ],
        "rule": "bit=1 iff left pixel > right pixel"
      },
      "orientations": 8,
      "phash": {
        "bits": 64,
        "coefficients": "top-left 8x8 (row-major)",
        "resample": "Pillow LANCZOS",
        "resize": [
          32,
          32
        ],
        "threshold": "median of the 64 coefficients; bit=1 iff coefficient > median",
        "transform": "explicit orthonormal 2-D DCT-II, float64 cosine matrix"
      },
      "preprocessing": "verify source bytes against the manifest sha256; apply EXIF transpose; convert deterministically to grayscale; generate all 8 dihedral orientations (4 rotations and their horizontal mirrors) before hashing",
      "search": "exact radius-search index (BK-tree), one per hash type, over every orientation hash of the query side, queried against an index built from every orientation hash of the indexed side; a brute-force reference implementation is retained for small synthetic tests only and proven equal to the indexed output.",
      "thresholds": {
        "dhash_max_hamming_distance": 8,
        "phash_max_hamming_distance": 10
      }
    },
