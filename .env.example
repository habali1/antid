# ---- Storage ----
STORAGE_BUCKET=antid-training            # GCS or S3 bucket (gs://… or s3://…)
GOOGLE_APPLICATION_CREDENTIALS=          # path to GCP service-account json (GCS)
# AWS_ACCESS_KEY_ID=                      # or AWS creds (S3)
# AWS_SECRET_ACCESS_KEY=

# ---- Database ----
DATABASE_URL=postgresql://user:pass@localhost:5432/antid

# ---- Training ----
WANDB_API_KEY=                           # optional; stdout+tqdm if unset
LOCAL_DATA_DIR=./data                    # optional local image cache

# ---- API / App ----
API_BASE_URL=http://localhost:8000
